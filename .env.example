# Copy to .env (make bootstrap does this). All variables are required except where noted.
# AWS keys are FAKE: LocalStack never talks to AWS and preflight rejects any other value.
# LOCALSTACK_AUTH_TOKEN is a LocalStack account token (not an AWS credential) and is REQUIRED:
# LocalStack 2026.x exits with "License activation failed" without it. Never commit it.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Internal (container-to-container) and public (host/browser, used for presigned URLs) endpoints
AWS_ENDPOINT_URL=http://localstack:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true

# Pinned LocalStack tag. Verify licence/token needs before bumping.
LOCALSTACK_IMAGE_TAG=2026.10.2
LOCALSTACK_AUTH_TOKEN=

POSTGRES_USER=canvas
POSTGRES_PASSWORD=canvas
POSTGRES_DB=canvas
DATABASE_URL=postgres://canvas:canvas@postgres:5432/canvas
REDIS_URL=redis://redis:6379

BUCKET_INGEST=media-ingest-poc
BUCKET_DERIVED=media-derived-poc
BUCKET_PUBLISHED=media-published-poc

# Host ports (bound to 127.0.0.1). Postgres 5433 and Redis 6380 avoid clashing with local 5432/6379.
HOST_PORT_LOCALSTACK=4566
HOST_PORT_POSTGRES=5433
HOST_PORT_REDIS=6380
HOST_PORT_API=3000
HOST_PORT_TRANSCODER=3103
HOST_PORT_GC=3104

# SQS (POC-003). Uploads land under UPLOAD_STAGING_PREFIX in the ingest bucket; only that prefix is routed.
QUEUE_LIGHT_PROCESSING=light-processing
QUEUE_LIGHT_PROCESSING_DLQ=light-processing-dlq
QUEUE_AI_REQUESTS=ai-requests
QUEUE_AI_REQUESTS_DLQ=ai-requests-dlq
QUEUE_TRANSCODE_REQUESTS=transcode-requests
QUEUE_TRANSCODE_REQUESTS_DLQ=transcode-requests-dlq
QUEUE_PUBLISH_TASKS=publish-tasks
QUEUE_PUBLISH_TASKS_DLQ=publish-tasks-dlq
SQS_MAX_RECEIVE_COUNT=3
UPLOAD_STAGING_PREFIX=staging/

# Upload limits and presign lifetime (POC-006)
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=209715200
UPLOAD_URL_TTL_SECONDS=900

# light-worker failure injection via job payload, for tests (POC-012). Local POC only.
WORKER_TEST_HOOKS=true

# Drafts (POC-014, POC-019)
MAX_DOCUMENT_BYTES=2097152
DRAFT_PURGE_GRACE_DAYS=30
# Overrides the days value, in seconds (M6 demos and tests)
# DRAFT_PURGE_GRACE_SECONDS=300

# Mock transcoder (POC-023): simulated job latency. It places a fixture; it does not transcode.
MOCK_TRANSCODE_LATENCY_MS=1500

# Publish workflow (M5)
PUBLISH_WAIT_SECONDS=2
PUBLISH_MAX_ASSET_POLLS=30
PUBLISH_CANVAS_TIMEOUT_SECONDS=900
PUBLISH_TRANSCODE_TIMEOUT_SECONDS=120
PUBLISH_MAX_ATTEMPTS=5

# Garbage collection (M6). Seconds. Minutes here so the demo is quick; production-style defaults are in services/shared/config.ts.
# GC_INTERVAL_SECONDS=0 means no timer: run a cycle with `make gc-run`.
GC_INTERVAL_SECONDS=0
GC_BATCH_SIZE=50
GC_UPLOAD_EXPIRY_GRACE_SECONDS=300
GC_UNATTACHED_GRACE_SECONDS=300
GC_ORPHAN_GRACE_SECONDS=300
GC_JOB_STALE_SECONDS=300
GC_RECONCILE_AFTER_SECONDS=300
GC_STRAY_GRACE_SECONDS=300
GC_DELETE_STRAYS=false
GC_REVISION_KEEP_LAST=20
GC_REVISION_MIN_AGE_SECONDS=300
