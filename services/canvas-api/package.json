{
  "name": "canvas-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/canvas-api/src/main.js",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/client-sfn": "3.1156.0",
    "@aws-sdk/client-sqs": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "rootDir": ".",
    "roots": [
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "testTimeout": 60000
  }
}
