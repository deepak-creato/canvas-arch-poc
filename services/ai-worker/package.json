{
  "name": "ai-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/ai-worker/src/main.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1156.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "20.19.0",
    "@types/pg": "8.23.1",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "rootDir": ".",
    "roots": [
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "testTimeout": 60000
  }
}
